              "dataTransform": {
                "remote": true,
                "transform": "(\n  $EXCLUDED_KEYS := [\n    \"_id\",\n    \"createdAt\",\n    \"createdByUserId\",\n    \"updatedAt\",\n    \"updatedByUserId\"\n  ];\n  \n  $api := $coalesce([$variables.api, api]);\n  $model := $coalesce([$variables.model, model]);\n  \n  $modelFields := $indexBy(\n    $query({\n      \"api\": $lowercase($api),\n      \"statement\":'query Model($type: String!) {\n        modelMap(where: { name: { _eq: $type }})\n      }',\n      \"variables\":{\n        \"type\": $model & \"Document\"\n      }\n    }).modelMap.*.fields,\n    function($field) {\n      $field.name\n    }\n  );\n  \n  $isType := function($field, $type) {\n    $field.type = $type or $field.type = $type & \"!\"\n  };\n  \n  $formatData := function($fieldName, $record) {(\n    $value := $lookup($record, $fieldName);\n    $field := $lookup($modelFields, $fieldName);\n    \n    $isType($field, 'Date') ?\n      $moment($value).format(\"L\") :\n    $isType($field, 'Time') ?\n      $moment($value).format(\"LT\") :\n    $isType($field, 'DateTime') ?\n      $moment($value).format(\"L LT\") :\n    $isType($field, 'JSON') or $isType($field, 'JSONObject') ?\n      $jsonStringify($value, { \"space\": 2 }) :\n    $isType($field, 'Boolean') ?\n      ($value = true ? '\\u2714' : $value = false ? '\\u2716' : $value) :\n    $isType($field, 'Address') ?\n      $value.city & \", \" & $value.state & \" \" & $value.country :\n    $isType($field, 'Measure') ?\n      $value.value & \" \" & $value.unit.code :\n    $isType($field, 'RatioMeasure') ?\n      $value.value & \" \" & $value.numeratorUnit.code & \"/\" & $value.denominatorUnit.code :\n      $value\n  )};\n  \n  $nodes := $flatten($map(edges.node, function($node) {\n    (\n      $keys := [\n        $uniq(\n          $append(\n            $append(\n              $keys($node.difference.added), \n              $keys($node.difference.deleted)\n            ),\n            $keys($node.difference.updated)\n          )\n        )[$isNil($findFirst($EXCLUDED_KEYS, function($v) { $v = $ }))]\n      ];\n      \n      $append(\n        $merge([\n          $node,\n          {\n            \"groupData\": \"\",\n            \"groupChangedByUser\": $node.changedByUser,\n            \"hierarchy\": [$node.id]\n          }\n        ]),\n        $keys.(\n          $merge([$node, {\n            \"before\": null,\n            \"after\": null,\n            \"difference\": null,\n            \"fieldBefore\": null,\n            \"fieldAfter\": null\n          }, {\n            \"id\": $node.id & \"-\" & $,\n            \"changeId\": $node.id,\n            \"field\": $startCase($),\n            \"fieldBefore\": $formatData($, $node.before),\n            \"fieldAfter\": $formatData($, $node.after)\n          }]) ~> | $ | {\n            \"hierarchy\": [changeId, id]\n          } |\n        )\n      )\n    )\n  }));\n  \n  {\n    \"total\": $count($nodes),\n    \"edges\": $nodes.{\n      \"node\": $\n    }\n  }\n) "
              },
