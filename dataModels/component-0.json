            "retentionDays": 120
          },
          "labelField": "label",
          "triggers": {
            "update": "(\n  $doc := $doc ? $doc : $;\n  /* $where := {\"id\": id}; */\n  $output := $query({\"statement\":'query getConnection($connectionId: String, $masterDataFlowConfigId: String!) {\n    connection(where: {id: {_eq: $connectionId}}) {\n      edges {\n        node {\n          name\n          connector {\n            name\n          }\n        }\n      }\n    }\n    masterDataFlowConfiguration(where: {id: {_eq: $masterDataFlowConfigId }}) {\n      edges {\n        node {\n          connection {\n            name\n            connector {\n              name\n            }\n          }\n        }\n      }\n    }\n  }\n  ',\"variables\":{\n    \"connectionId\": $isNilOrEmpty($doc.connectionId) ? \"A_CONNECTION_THAT_DOESNT_EXIST\" : $doc.connectionId,\n    \"masterDataFlowConfigId\": $where.id\n  }}).{\n    \"newConnection\": connection.edges[0].node,\n    \"masterDataFlowConfig\": masterDataFlowConfiguration.edges[0].node\n  };\n  \n  $returnValue := function($beforeVal,$afterVal) {\n    $isNilOrEmpty($afterVal) ? $beforeVal : $afterVal\n  };\n\n  $merge(\n    [\n      $doc,\n      {\n        \"label\": $join(\n        [\n          $returnValue(\n            $output.masterDataFlowConfig.connection.connector.name,\n            $output.newConnection.connector.name\n          ),\n          $returnValue(\n            $output.masterDataFlowConfig.connection.name,\n            $output.newConnection.name\n          )\n        ],\n        \" - \")\n      }\n    ]\n  );\n)"
          }
        },
